#!/usr/bin/env python3
import argparse
import datetime
import os
import sys

from slurm_client import get_available_partitions, get_association_data, get_usage_data
from usage_calculator import calculate_usage
from report_renderer import render_report


def main():
    parser = argparse.ArgumentParser(
        description="Show Slurm usage by partition and account")
    parser.add_argument("-u", "--username",
                        help="Username to check usage for (optional)",
                        default=None)
    parser.add_argument("-S", "--start",
                        help="Start date (YYYY-MM-DD)",
                        default=(datetime.date.today().replace(day=1)).isoformat())
    parser.add_argument("-E", "--end",
                        help="End date (YYYY-MM-DD)",
                        default=datetime.date.today().isoformat())
    parser.add_argument("-A", "--account",
                        help="Specific account to check (optional)")
    args = parser.parse_args()

    current_user = os.getenv('USER')
    if current_user == 'root' and not (args.username or args.account):
        print("Error: As root, you must specify either a username or an account.")
        sys.exit(1)

    end_date = datetime.date.fromisoformat(args.end)
    current_date = datetime.date.today()
    if end_date == current_date:
        print("Warning: Report includes today's date. Some very recent jobs may not be included due to accounting delays.")
        print("For most accurate results, wait a few minutes and run the report again.")

    # Add a buffer to the end date.
    end_date_with_buffer = (datetime.datetime.combine(end_date, datetime.time.max) +
                            datetime.timedelta(minutes=15)).date()

    partitions = get_available_partitions()
    associations = get_association_data(args.account, args.username)
    usage_data = get_usage_data(
        args.start, end_date_with_buffer.isoformat(), args.account, args.username)
    usage_by_account, account_limits = calculate_usage(
        usage_data, associations, partitions)

    if not usage_by_account:
        print("No usage data found for the specified criteria.")
        sys.exit(0)

    title = f"Usage report from {args.start} to {args.end}"
    print(render_report(usage_by_account, account_limits, title))
    print('Note: "Hours" refers to GPU-hour for GPU partitions and CPU-core-hour for CPU partitions.')


if __name__ == "__main__":
    main()
