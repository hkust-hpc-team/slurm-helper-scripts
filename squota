#!/usr/bin/env python3

import subprocess
import datetime
import argparse
import sys
import os
from table import Table

partitions = ["gpu-a30", "gpu-l20", "amd", "intel", "admin"]

pricing = {
    "admin": 0.0,
    "intel": 0.014,
    "amd": 0.014,
    "gpu-a30": 2.13,
    "gpu-l20": 2.13,
}


def get_usage_rawdata(start_date, end_date, account=None, username=None) -> list:
    cmd = [
        "sacct", "-n", "-P", "-X",
        "-S", start_date,
        "-E", end_date,
        "--format=JobID,User,ElapsedRaw,AllocTRES,Partition,Account",
        "--truncate"
    ]

    if account:
        cmd.extend(["-A", account])

    if username:
        cmd.extend(["-u", username])

    try:
        result = subprocess.run(
            cmd, capture_output=True, text=True, check=True)
        result = result.stdout.strip().split('\n')
        return result
    except subprocess.CalledProcessError as e:
        print(f"Error running sacct command: {e}")
        print(f"Command output: {e.output}")
        return []


def parse_time(time_str_in_second):
    time_str_in_second = int(time_str_in_second)
    return time_str_in_second / 3600  # Convert to hours


def calculate_usage(usage_data):
    usage_by_account = {}
    all_accounts = set()

    for job in usage_data:
        if not job:
            continue
        job_parts = job.split('|')
        if len(job_parts) < 6:
            continue
        _, _, elapsed, alloc_tres, partition, account = job_parts

        if not partition or not account:
            continue

        hours = parse_time(elapsed)
        gpus = next((int(item.split('=')[1]) for item in alloc_tres.split(
            ',') if item.startswith('gres/gpu=')), 0)

        if gpus == 0:
            cpus = next((int(item.split('=')[1]) for item in alloc_tres.split(
                ',') if item.startswith('cpu=')), 1)

        if account not in usage_by_account:
            usage_by_account[account] = {"total": 0, "partitions": {}}

        if partition not in usage_by_account[account]["partitions"]:
            usage_by_account[account]["partitions"][partition] = {
                "hours": 0}

        hours = hours * gpus if gpus > 0 else hours * cpus
        usage_by_account[account]["partitions"][partition]["hours"] += hours
        all_accounts.add(account)

        usage_by_account[account]["total"] += hours

    return usage_by_account, all_accounts


def format_output(usage_by_account, title=None):
    print("")
    table = Table(title=title)
    table.add_column("Account", alignment='left')
    table.add_column("Total (HKD)", alignment='right')
    table.add_column("Partition Details", alignment='left')

    for account, data in usage_by_account.items():
        usage = 0
        for partition, usage_data in data["partitions"].items():
            usage += usage_data["hours"] * pricing.get(partition, 0)
        usage_str = f"{usage:.2f}"

        # Create a subtable for partition details
        partition_table = Table()
        partition_table.add_column("Partition", alignment='left')
        partition_table.add_column("Hours", alignment='right')

        data["partitions"] = dict(
            sorted(data["partitions"].items(), key=lambda x: x[1]["hours"], reverse=True))

        for partition, usage_data in data["partitions"].items():
            partition_table.add_row(
                [partition, f"{usage_data['hours']:.2f}"])

        # Add main table row with subtable
        table.add_row([account, usage_str, ""])
        # Attach the subtable to the last added row
        table.add_subtable(len(table.rows) - 1, 2, partition_table)

    return table.render()


def main():
    parser = argparse.ArgumentParser(
        description="Show Slurm usage by partition and account")
    parser.add_argument(
        "-u", "--username", help="Username to check usage for (optional)", default=None)
    parser.add_argument("-S", "--start", help="Start date (YYYY-MM-DD)",
                        default=(datetime.date.today().replace(day=1)).isoformat())
    parser.add_argument("-E", "--end", help="End date (YYYY-MM-DD)",
                        default=datetime.date.today().isoformat())
    parser.add_argument("-A", "--account",
                        help="Specific account to check (optional)")

    args = parser.parse_args()

    current_user = os.getenv('USER')

    if current_user != 'root':
        if args.username and args.username != current_user:
            print(
                f"Error: You don't have permission to view {args.username}'s usage.")
            sys.exit(1)
        args.username = current_user
        print(f"Using current user: {current_user}")
    else:
        if not args.username and not args.account:
            print("Error: As root, you must specify either a username or an account.")
            sys.exit(1)

    end_date = datetime.date.fromisoformat(args.end)
    current_date = datetime.date.today()

    if end_date == current_date:
        print("Warning: Report includes today's date. Some very recent jobs may not be included due to accounting delays.")
        print("For most accurate results, wait a few minutes and run the report again.")

    end_date_with_buffer = (datetime.datetime.combine(
        end_date, datetime.time.max) + datetime.timedelta(minutes=15)).date()

    usage_data = get_usage_rawdata(
        args.start, end_date_with_buffer.isoformat(), args.account, args.username)
    usage_by_account, _ = calculate_usage(usage_data)

    if not usage_by_account:
        print("No usage data found for the specified criteria.")
        sys.exit(0)

    title = f"Usage report from {args.start} to {args.end}"
    print(format_output(usage_by_account, title=title))


if __name__ == "__main__":
    main()
